ARG base_image=pytorch/pytorch:2.7.1-cuda12.8-cudnn9-devel
FROM $base_image


ARG DEBIAN_FRONTEND=noninteractive
ARG timezone="Asia/Jerusalem"

ENV TZ=$timezone
ENV YOLOX_DATADIR=/workspace/data

ENV PYTORCH_CUDA_ALLOC_CONF=expandable_segments:False


RUN apt-get update && \
    ln -snf /usr/share/zoneinfo/$TZ /etc/localtime && \
    echo $TZ > /etc/timezone && \
    apt-get install -y --no-install-recommends \
        vim git wget sudo tmux \
        build-essential \
        libgl1 libglib2.0-0 && \
    apt-get clean && \
    rm -rf /var/lib/apt/lists/*


# Install local PyTorch wheel
# COPY pytorch/*.whl /tmp/

ARG repo=https://github.com/hailo-ai/YOLOX
RUN mkdir /workspace/data && \
    git clone $repo && \
    cd YOLOX && pip install --upgrade pip && \
    sed -i '/^torch/d' requirements.txt && \
    sed -i '/^onnx/d' requirements.txt && \
    sed -i '/^onnxruntime/d' requirements.txt && \
    sed -i 's/^numpy==.*/numpy<2/' requirements.txt && \
    pip install -r requirements.txt && \
    pip install cython==0.29.24 'protobuf<3.21' && \
    pip install -e . --no-build-isolation && \
    sed -i 's|img_file = os.path.join(self.data_dir, self.name, file_name)|img_file = os.path.join(self.data_dir, "images", file_name)|' \
        yolox/data/datasets/coco.py
ENV YOLOX_DATADIR=/workspace/data

WORKDIR /workspace/YOLOX

RUN wget https://github.com/Megvii-BaseDetection/YOLOX/releases/download/0.1.1rc0/yolox_s.pth && \
    wget https://github.com/Megvii-BaseDetection/YOLOX/releases/download/0.1.1rc0/yolox_m.pth && \
    wget https://github.com/Megvii-BaseDetection/YOLOX/releases/download/0.1.1rc0/yolox_l.pth && \
    wget https://github.com/Megvii-BaseDetection/YOLOX/releases/download/0.1.1rc0/yolox_x.pth

ARG user=hailo
ARG group=hailo
ARG uid=1000
ARG gid=1000

RUN groupadd --gid $gid $group && \
    adduser --uid $uid --gid $gid --shell /bin/bash --disabled-password --gecos "" $user && \
    chmod u+w /etc/sudoers && echo "$user ALL=(ALL) NOPASSWD: ALL" >> /etc/sudoers && chmod -w /etc/sudoers && \
    chown -R $user:$group /workspace