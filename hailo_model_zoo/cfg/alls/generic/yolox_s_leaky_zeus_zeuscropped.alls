model_optimization_config(calibration, batch_size=2, calibset_size=64)
input_conversion = input_conversion(bgr_to_rgb)
pre_quantization_optimization(equalization, policy=enabled)
pre_quantization_optimization(activation_clipping, layers=[conv82], mode=percentile, clipping_values=[0.1, 99.9])
post_quantization_optimization(finetune, policy=disabled)

nms_postprocess("../../postprocess_config/nms_config_yolox_s_leaky_zeus_zeuscropped.json", yolox, engine=cpu)

allocator_param(num_of_workers=1)
